#!/usr/bin/env sh
set -eu

usage() {
    cat <<'USAGE'
agent-kit helper

Usage:
  ak doctor
  ak init
  ak plan <title>
  ak lavish <html-file>
  ak herdr-tab <slug> [cwd] [command...]
  ak role
  ak whoami
  ak phase [show|set <phase>]
  ak primary-set [--notify-only|--allow-inject] [target]
  ak primary-show
  ak crew-spawn <slug> <brief text...>
  ak crew-status
  ak crew-audit
  ak crew-report <slug> <message text...>
  ak crew-resume <slug>
  ak crew-cost <slug> <usd|unknown> [note...]
  ak crew-checkpoint <slug> <item text...>
  ak crew-cost-summary
  ak crew-cost-prompt [message...]
  ak crew-peek <slug> [lines]
  ak crew-send <slug> <message text...>
  ak chat [<slug>] [lines]
  ak crew-finish <slug> [report text...]
  ak docs [list|show <name>]

Worker commands (run from inside a crew worktree):
  ak reply <message text...>   message the primary mid-task and wake it
  ak done <message text...>    report completion and wake the primary

Roles:
  A session is a "worker" when this checkout has a worker role marker
  (written by crew-spawn); otherwise it is the "primary" by default.
  Run "ak role" first to find out which you are.

Phases (backend-dev loop, tracked in .agent-kit/phase):
  research -> planning -> awaiting-approval -> implementing -> testing -> done

Environment:
  AK_BACKEND             session backend (default: herdr; only herdr implemented)
  AK_HERDR_SESSION       Herdr session name (default: default)
  AK_HERDR_WORKSPACE     Herdr workspace label override; unset uses the
                         current Herdr workspace (HERDR_WORKSPACE_ID) when ak
                         runs inside a Herdr-managed pane, else "agent-kit"
  AK_CREW_COMMAND        command run in new crew tab (default: pi)
  AK_CREW_STARTUP_TIMEOUT max ms overall deadline for a crew startup prompt to
                         be CONFIRMED accepted (default: 120000); spawn exits
                         non-zero if delivery cannot be confirmed
  AK_CREW_READY_TIMEOUT  max ms to wait for the crew pane's agent to report an
                         input-ready state before the startup prompt is sent
                         (default: 15000)
  AK_WAKE_ACCEPT_TIMEOUT max ms to wait for a woken agent to enter the working
                         state before a wake is reported unconfirmed
                         (default: 8000)
  AK_NO_NOTIFY           disable backend notifications when set to 1
  AK_NO_WAKE             disable primary wakeup injection when set to 1
  AK_COST_CURRENCY       currency label for crew-cost (default: USD)
USAGE
}

slugify() {
    printf '%s' "$*" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9][^a-z0-9]*/-/g; s/^-//; s/-$//' | cut -c1-60
}

need() {
    command -v "$1" >/dev/null 2>&1 || {
        printf 'missing: %s\n' "$1" >&2
        return 1
    }
}

self_path() {
    case $0 in
    /*) printf '%s\n' "$0" ;;
    */*)
        dir=$(dirname "$0")
        base=$(basename "$0")
        (cd "$dir" 2>/dev/null && printf '%s/%s\n' "$PWD" "$base") || printf '%s\n' "$0"
        ;;
    *) command -v "$0" 2>/dev/null || printf '%s\n' "$0" ;;
    esac
}

# Follow a chain of symlinks to their final target, POSIX-portable (no
# dependency on GNU readlink -f / coreutils realpath being installed).
resolve_symlink_chain() {
    path=$1
    n=0
    while [ -L "$path" ] && [ "$n" -lt 40 ]; do
        link=$(readlink "$path")
        case "$link" in
        /*) path=$link ;;
        *) path=$(cd "$(dirname "$path")" && cd "$(dirname "$link")" && pwd)/$(basename "$link") ;;
        esac
        n=$((n + 1))
    done
    printf '%s\n' "$path"
}

# Root of the ak toolkit checkout itself (containing bin/ak and docs/),
# resolved from this script's own symlink chain. This is independent of the
# caller's cwd/repo, so "ak docs ..." works the same from any repository -
# unlike repo_root(), which walks the *caller's* jj/git root for .agent-kit
# state.
ak_home_dir() {
    p=$(resolve_symlink_chain "$(self_path)")
    dirname "$(dirname "$p")"
}

docs_dir() {
    printf '%s/docs' "$(ak_home_dir)"
}

docs_list() {
    dir=$(docs_dir)
    [ -d "$dir" ] || {
        printf 'no docs directory: %s\n' "$dir" >&2
        exit 1
    }
    for f in "$dir"/*.md; do
        [ -f "$f" ] || continue
        basename "$f" .md
    done
}

docs_show() {
    [ "$#" -ge 1 ] || {
        printf 'usage: ak docs show <name>\n' >&2
        exit 2
    }
    name=$1
    name=${name%.md}
    dir=$(docs_dir)
    path="$dir/$name.md"
    [ -f "$path" ] || {
        printf 'unknown doc: %s\n' "$name" >&2
        printf 'available docs:\n' >&2
        docs_list >&2
        exit 1
    }
    cat "$path"
}

ak_docs() {
    sub=${1:-list}
    case "$sub" in
    list)
        docs_list
        ;;
    show)
        shift
        docs_show "$@"
        ;;
    *)
        # shorthand: ak docs <name> == ak docs show <name>
        docs_show "$sub"
        ;;
    esac
}

doctor() {
    ok=0
    for tool in git npx; do need "$tool" || ok=1; done
    if command -v jj >/dev/null 2>&1; then printf 'ok: jj\n'; else printf 'info: jj not installed\n'; fi
    if command -v herdr >/dev/null 2>&1; then
        printf 'ok: herdr (%s)\n' "$(herdr status --json 2>/dev/null | sed 's/[[:space:]]\+/ /g' | cut -c1-160 || printf 'status unavailable')"
    else
        printf 'missing: herdr (required for Herdr tab helpers)\n' >&2
        ok=1
    fi
    if command -v jq >/dev/null 2>&1; then printf 'ok: jq\n'; else
        printf 'missing: jq (required for Herdr JSON parsing)\n' >&2
        ok=1
    fi
    return "$ok"
}

append_once() {
    file=$1
    line=$2
    mkdir -p "$(dirname "$file")"
    [ -f "$file" ] || : >"$file"
    grep -qxF "$line" "$file" 2>/dev/null || printf '%s\n' "$line" >>"$file"
}

ensure_runtime_ignored() {
    root=$(repo_root 2>/dev/null || printf '%s' "$PWD")
    exclude="$root/.git/info/exclude"
    if [ -d "$root/.git/info" ]; then
        append_once "$exclude" '# agent-kit local runtime state'
        append_once "$exclude" '.agent-kit/'
        append_once "$exclude" '.lavish/'
    fi
}

lock_acquire() {
    lockdir=$1
    mkdir -p "$(dirname "$lockdir")"
    i=0
    while ! mkdir "$lockdir" 2>/dev/null; do
        i=$((i + 1))
        if [ "$i" -ge 120 ]; then
            printf 'timed out waiting for lock: %s\n' "$lockdir" >&2
            exit 1
        fi
        sleep 0.5
    done
    AK_LOCK_DIR=$lockdir
    trap 'if [ -n "${AK_LOCK_DIR:-}" ]; then rmdir "$AK_LOCK_DIR" 2>/dev/null || true; fi' EXIT HUP INT TERM
}

lock_release() {
    if [ -n "${AK_LOCK_DIR:-}" ]; then
        rmdir "$AK_LOCK_DIR" 2>/dev/null || true
        AK_LOCK_DIR=
        trap - EXIT HUP INT TERM
    fi
}

init_dirs() {
    mkdir -p .agent-kit/plans .agent-kit/reports .agent-kit/logs .agent-kit/crew .agent-kit/worktrees .lavish
    ensure_runtime_ignored
    printf 'initialized .agent-kit/ and .lavish/\n'
}

new_plan() {
    [ "$#" -gt 0 ] || {
        printf 'plan title required\n' >&2
        exit 2
    }
    title=$*
    slug=$(slugify "$title")
    [ -n "$slug" ] || slug=plan
    path=".agent-kit/plans/$(date +%Y%m%d-%H%M%S)-$slug.md"
    mkdir -p .agent-kit/plans
    cat >"$path" <<EOF
# $title

## Objective

## Constraints

## Plan

- [ ] Orient
- [ ] Implement smallest correct change
- [ ] Verify
- [ ] Handoff

## Verification

## Notes
EOF
    printf '%s\n' "$path"
}

open_lavish() {
    [ "$#" -eq 1 ] || {
        printf 'html file required\n' >&2
        exit 2
    }
    npx -y lavish-axi "$1"
}

herdr_server_ensure() {
    session=$1
    running=$(herdr status --json --session "$session" 2>/dev/null | jq -r '.server.running // false' 2>/dev/null || printf false)
    [ "$running" = true ] && return 0
    (herdr server --session "$session" >/dev/null 2>&1 &) || return 1
    i=0
    while [ "$i" -lt 20 ]; do
        running=$(herdr status --json --session "$session" 2>/dev/null | jq -r '.server.running // false' 2>/dev/null || printf false)
        [ "$running" = true ] && return 0
        i=$((i + 1))
        sleep 0.5
    done
    printf 'herdr server did not start for session: %s\n' "$session" >&2
    return 1
}

herdr_workspace_id() {
    session=$1
    label=$2
    herdr_server_ensure "$session"
    if out=$(herdr workspace list --session "$session" 2>/dev/null); then
        id=$(printf '%s' "$out" | jq -r --arg label "$label" '(.result.workspaces // .workspaces // [])[] | select(.label == $label) | (.workspace_id // .id) ' 2>/dev/null | head -n 1)
        [ -n "$id" ] && {
            printf '%s' "$id"
            return 0
        }
    fi
    out=$(herdr workspace create --label "$label" --cwd "$PWD" --no-focus --session "$session")
    printf '%s' "$out" | jq -r '.result.workspace.workspace_id // .workspace.workspace_id // .workspace.id // .result.workspace.id'
}

# Resolve which Herdr workspace crew/scratch tabs should land in.
#
# Preference order:
#   1. explicit AK_HERDR_WORKSPACE override (label-based lookup/create, as
#      before) - lets a user pin a dedicated workspace if they want one.
#   2. the workspace this ak invocation is already running inside
#      (HERDR_WORKSPACE_ID, set by Herdr for panes it manages) - keeps one
#      Herdr space per project instead of spawning a separate "agent-kit"
#      workspace.
#   3. fall back to the legacy "agent-kit" label when ak is invoked outside
#      a Herdr-managed pane (e.g. from a script or another terminal).
#
# Sets herdr_resolved_workspace_id and herdr_resolved_workspace_label.
herdr_resolve_workspace() {
    session=$1
    if [ -n "${AK_HERDR_WORKSPACE:-}" ]; then
        herdr_resolved_workspace_label=$AK_HERDR_WORKSPACE
        herdr_resolved_workspace_id=$(herdr_workspace_id "$session" "$AK_HERDR_WORKSPACE")
        return 0
    fi
    if [ -n "${HERDR_WORKSPACE_ID:-}" ]; then
        herdr_resolved_workspace_id=$HERDR_WORKSPACE_ID
        herdr_resolved_workspace_label=$(herdr workspace get "$HERDR_WORKSPACE_ID" --session "$session" 2>/dev/null | jq -r '.result.workspace.label // .workspace.label // empty' 2>/dev/null || true)
        [ -n "$herdr_resolved_workspace_label" ] || herdr_resolved_workspace_label=$HERDR_WORKSPACE_ID
        return 0
    fi
    herdr_resolved_workspace_label=agent-kit
    herdr_resolved_workspace_id=$(herdr_workspace_id "$session" agent-kit)
}

herdr_agent_kind_list=' pi claude codex gemini cursor devin agy cline omp mastracode opencode copilot kimi kiro droid amp grok hermes kilo qodercli maki '

herdr_agent_kind_of() {
    word=$1
    case "$herdr_agent_kind_list" in
    *" $word "*) printf '%s\n' "$word" ;;
    *) return 1 ;;
    esac
}

herdr_valid_agent_name() {
    case "$1" in
    '') return 1 ;;
    esac
    printf '%s' "$1" | grep -Eq '^[a-z][a-z0-9_-]{0,31}$'
}

# Whether this herdr can attach a named agent to an EXISTING pane (the
# `--kind/--pane` form herdr_agent_start_retry uses). Herdr 0.7 replaced that
# with `herdr agent start <name> ... -- <argv>`, which creates and owns its own
# pane, so crew-spawn's tab layout falls back to `herdr pane run`. Probe the
# flag instead of whitelisting versions, so the unsupported attempt is skipped
# (and not warned about) on every spawn.
herdr_agent_pane_attach_supported() {
    herdr agent start --help 2>&1 | grep -q -- '--pane'
}

# Start a known agent kind in an existing pane, retrying briefly while the
# pane's shell is not yet an available interactive prompt. Echoes nothing;
# sets herdr_agent_start_error on failure.
herdr_agent_start_retry() {
    name=$1
    kind=$2
    pane=$3
    session=$4
    shift 4
    i=0
    while [ "$i" -lt 10 ]; do
        if [ "$#" -gt 0 ]; then
            if start_out=$(herdr agent start "$name" --kind "$kind" --pane "$pane" --session "$session" -- "$@" 2>&1); then
                herdr_agent_start_error=
                return 0
            fi
        else
            if start_out=$(herdr agent start "$name" --kind "$kind" --pane "$pane" --session "$session" 2>&1); then
                herdr_agent_start_error=
                return 0
            fi
        fi
        case "$start_out" in
        *agent_pane_busy*) : ;;
        *)
            herdr_agent_start_error=$start_out
            return 1
            ;;
        esac
        i=$((i + 1))
        sleep 0.5
    done
    herdr_agent_start_error=$start_out
    return 1
}

herdr_tab_create() {
    tab_slug=$1
    cwd=$2
    shift 2
    [ -d "$cwd" ] || {
        printf 'cwd does not exist: %s\n' "$cwd" >&2
        exit 1
    }
    session=${AK_HERDR_SESSION:-default}
    herdr_resolve_workspace "$session"
    workspace=$herdr_resolved_workspace_label
    wsid=$herdr_resolved_workspace_id
    label="ak-$tab_slug"
    out=$(herdr tab create --workspace "$wsid" --label "$label" --cwd "$cwd" --no-focus --session "$session")
    pane=$(printf '%s' "$out" | jq -r '.result.root_pane.pane_id // .root_pane.pane_id // empty')
    tab=$(printf '%s' "$out" | jq -r '.result.tab.tab_id // .tab.tab_id // empty')
    printf 'created Herdr tab %s in workspace %s (session %s)\n' "$label" "$workspace" "$session"
    [ -n "$tab" ] && printf 'tab: %s\n' "$tab"
    [ -n "$pane" ] && printf 'pane: %s\n' "$pane"
    HERDR_CREATED_AGENT_NAME=
    HERDR_CREATED_AGENT_KIND=
    if [ "$#" -gt 0 ]; then
        cmd=$*
        [ -n "$pane" ] || {
            printf 'could not parse pane id; not running command\n' >&2
            exit 1
        }
        kind=
        if [ -n "${AK_TAB_AGENT_NAME:-}" ] && herdr_valid_agent_name "$AK_TAB_AGENT_NAME"; then
            first_word=$(printf '%s' "$cmd" | awk '{print $1}')
            kind=$(herdr_agent_kind_of "$first_word" || true)
        fi
        # Record the resolved agent kind for startup-prompt delivery even when
        # this herdr cannot attach it to the existing pane (0.7.x): the pane
        # still auto-detects that harness, so the kind is still what we expect.
        HERDR_CREATED_AGENT_KIND=$kind
        if [ -n "$kind" ] && ! herdr_agent_pane_attach_supported; then
            printf 'note: this herdr starts agents in their own pane and cannot attach one to an existing pane; running %s via pane run (Herdr auto-detects it)\n' "$kind" >&2
            kind=
        fi
        if [ -n "$kind" ]; then
            rest=$(printf '%s' "$cmd" | cut -d' ' -f2-)
            [ "$rest" != "$cmd" ] || rest=
            if [ -n "$rest" ]; then
                # shellcheck disable=SC2086
                herdr_agent_start_retry "$AK_TAB_AGENT_NAME" "$kind" "$pane" "$session" $rest || true
            else
                herdr_agent_start_retry "$AK_TAB_AGENT_NAME" "$kind" "$pane" "$session" || true
            fi
            if [ -z "${herdr_agent_start_error:-}" ]; then
                printf 'started agent: %s (%s)\n' "$AK_TAB_AGENT_NAME" "$kind"
                HERDR_CREATED_AGENT_NAME=$AK_TAB_AGENT_NAME
            else
                printf 'warning: herdr agent start failed for kind %s; falling back to pane run: %s\n' "$kind" "$herdr_agent_start_error" >&2
                herdr pane run "$pane" "$cmd" --session "$session"
                printf 'ran: %s\n' "$cmd"
            fi
        else
            herdr pane run "$pane" "$cmd" --session "$session"
            printf 'ran: %s\n' "$cmd"
        fi
    fi
    HERDR_CREATED_SESSION=$session
    HERDR_CREATED_WORKSPACE=$workspace
    HERDR_CREATED_TAB=$tab
    HERDR_CREATED_PANE=$pane
}

herdr_tab() {
    [ "$#" -ge 1 ] || {
        printf 'slug required\n' >&2
        exit 2
    }
    need herdr >/dev/null
    need jq >/dev/null
    slug=$(slugify "$1")
    shift
    [ -n "$slug" ] || {
        printf 'invalid slug\n' >&2
        exit 2
    }
    cwd=${1:-$PWD}
    if [ "$#" -gt 0 ]; then shift; fi
    herdr_tab_create "$slug" "$cwd" "$@"
}

repo_root() {
    if command -v jj >/dev/null 2>&1 && root=$(jj root 2>/dev/null); then
        printf '%s\n' "$root"
        return 0
    fi
    git rev-parse --show-toplevel 2>/dev/null || {
        printf 'not inside a git or jj repository
' >&2
        exit 1
    }
}

repo_vcs() {
    root=$(repo_root)
    if [ -e "$root/.jj" ] && command -v jj >/dev/null 2>&1; then
        printf 'jj\n'
    else
        printf 'git\n'
    fi
}

agentkit_dir() {
    printf '%s/.agent-kit' "$(repo_root)"
}

primary_path() {
    printf '%s/primary' "$(agentkit_dir)"
}

primary_show() {
    path=$(primary_path)
    if [ -f "$path" ]; then
        cat "$path"
    else
        printf 'no primary registered\n'
        return 1
    fi
}

is_registered_crew_target() {
    target=$1
    base=$(crew_base)
    [ -d "$base" ] || return 1
    find "$base" -mindepth 2 -maxdepth 2 -name meta -type f 2>/dev/null | while IFS= read -r meta; do
        slug=$(basename "$(dirname "$meta")")
        pane=$(awk -F= '$1=="herdr_pane" {print substr($0, index($0,"=")+1); exit}' "$meta")
        tab=$(awk -F= '$1=="herdr_tab" {print substr($0, index($0,"=")+1); exit}' "$meta")
        if [ "$target" = "$slug" ] || { [ -n "$pane" ] && [ "$target" = "$pane" ]; } || { [ -n "$tab" ] && [ "$target" = "$tab" ]; }; then
            printf '%s\n' "$slug"
            exit 0
        fi
    done | grep -m 1 . >/dev/null 2>&1
}

primary_set() {
    session=${AK_HERDR_SESSION:-default}
    inject=1
    if [ "${1:-}" = "--notify-only" ]; then
        inject=0
        shift
    elif [ "${1:-}" = "--allow-inject" ]; then
        inject=1
        shift
    fi
    target=${1:-}
    explicit_target=0
    if [ -z "$target" ]; then
        info=$(herdr pane current --current --session "$session" 2>/dev/null) || {
            printf 'could not inspect current Herdr pane; pass an explicit target\n' >&2
            exit 1
        }
    else
        explicit_target=1
        if is_registered_crew_target "$target"; then
            printf 'refusing to register crew target as primary: %s\n' "$target" >&2
            printf 'run primary-set from the actual primary Herdr pane, or pass its pane id explicitly\n' >&2
            exit 1
        fi
        info=$(herdr pane get "$target" --session "$session" 2>/dev/null || herdr agent get "$target" --session "$session" 2>/dev/null || true)
        [ -n "$info" ] || {
            printf 'primary target not found in Herdr session %s: %s\n' "$session" "$target" >&2
            exit 1
        }
    fi
    target=$(printf '%s' "$info" | jq -r '.result.pane.pane_id // .pane.pane_id // .pane_id // .result.agent.pane_id // .agent.pane_id // empty' 2>/dev/null)
    agent=$(printf '%s' "$info" | jq -r '.result.pane.agent // .pane.agent // .result.agent.agent // .agent.agent // empty' 2>/dev/null)
    tab=$(printf '%s' "$info" | jq -r '.result.pane.tab_id // .pane.tab_id // .result.agent.tab_id // .agent.tab_id // empty' 2>/dev/null)
    workspace=$(printf '%s' "$info" | jq -r '.result.pane.workspace_id // .pane.workspace_id // .result.agent.workspace_id // .agent.workspace_id // empty' 2>/dev/null)
    cwd=$(printf '%s' "$info" | jq -r '.result.pane.cwd // .pane.cwd // .result.agent.cwd // .agent.cwd // empty' 2>/dev/null)
    [ -n "$target" ] || {
        printf 'could not determine primary target\n' >&2
        exit 1
    }
    if [ "$explicit_target" = 0 ] && is_registered_crew_target "$target"; then
        printf 'refusing to register crew pane as primary: %s\n' "$target" >&2
        printf 'switch to the actual primary Herdr pane and run primary-set there\n' >&2
        exit 1
    fi
    ensure_runtime_ignored
    mkdir -p "$(agentkit_dir)"
    cat >"$(primary_path)" <<EOF
session=$session
target=$target
agent=$agent
tab=${tab:-}
workspace=${workspace:-}
cwd=${cwd:-}
inject=$inject
registered_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)
EOF
    printf 'primary target registered: %s\n' "$target"
    if [ "$inject" = 1 ]; then
        printf 'primary wakeup: enabled (crew reports will message this agent)\n'
    else
        printf 'primary wakeup: disabled (notifications/inbox only)\n'
    fi
}

primary_target() {
    path=$(primary_path)
    [ -f "$path" ] || return 1
    awk -F= '$1=="target" {print substr($0, index($0,"=")+1); exit}' "$path"
}

primary_session() {
    path=$(primary_path)
    [ -f "$path" ] || return 1
    awk -F= '$1=="session" {print substr($0, index($0,"=")+1); exit}' "$path"
}

primary_inject() {
    path=$(primary_path)
    [ -f "$path" ] || return 1
    awk -F= '$1=="inject" {print substr($0, index($0,"=")+1); exit}' "$path"
}

primary_notify() {
    message=$*
    session=$(primary_session 2>/dev/null || printf '%s' "${AK_HERDR_SESSION:-default}")
    backend_notify "$session" "agent-kit crew update" "$message"
    [ "${AK_NO_WAKE:-0}" = 1 ] && return 0
    [ "$(primary_inject 2>/dev/null || printf 1)" = 1 ] || return 0
    target=$(primary_target 2>/dev/null || true)
    [ -n "$target" ] || return 0
    # Fire-and-forget wake via the backend seam. For herdr this submits via the
    # agent surface (honoring bracketed-paste) and falls back to raw pane input
    # for a plain shell pane.
    backend_wake "$session" "$target" "$message" >/dev/null 2>&1 || true
}

crew_base() {
    printf '%s/.agent-kit/crew' "$(repo_root)"
}

crew_dir() {
    printf '%s/%s' "$(crew_base)" "$1"
}

crew_meta_path() {
    printf '%s/meta' "$(crew_dir "$1")"
}

crew_report_path() {
    printf '%s/report.md' "$(crew_dir "$1")"
}

crew_cost_path() {
    printf '%s/cost.tsv' "$(crew_dir "$1")"
}

crew_progress_path() {
  printf '%s/progress.tsv' "$(crew_dir "$1")"
}

# The repo root that owns .agent-kit/crew state. From a worker worktree this
# is the primary repo recorded in the role marker; elsewhere it is the current
# checkout's root. This makes crew-ledger commands worktree-safe the same way
# ak done / ak reply / ak chat are.
crew_root() {
    if is_worker; then
        marker=$(role_marker_path 2>/dev/null) || true
        if [ -n "${marker:-}" ] && [ -f "$marker" ]; then
            proot=$(role_field "$marker" primary_repo)
            if [ -n "$proot" ] && [ -d "$proot" ]; then
                printf '%s\n' "$proot"
                return 0
            fi
        fi
    fi
    repo_root
}

# Record a durable "a wake could not be confirmed" marker in the crew state
# file so the primary can discover it without watching stderr. On repeated
# failures the latest timestamp is the last undelivered_at line.
mark_wake_undelivered() {
    root=$1
    slug=$2
    state="$root/.agent-kit/crew/$slug/state"
    [ -d "$(dirname "$state")" ] || return 0
    printf 'undelivered_at=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >>"$state"
}

crew_branch_name() {
    printf 'ak/%s' "$1"
}

jj_current_change_id() {
    jj -R "$1" log --no-graph -r @ -T 'change_id.short()' --no-pager 2>/dev/null
}

jj_change_empty() {
    root=$1
    rev=$2
    [ -n "$rev" ] || return 1
    [ -z "$(jj -R "$root" diff -r "$rev" --summary 2>/dev/null)" ]
}

jj_change_description() {
    jj -R "$1" log --no-graph -r "$2" -T 'description' --no-pager 2>/dev/null
}

jj_abandon_empty_change() {
    root=$1
    rev=$2
    expected_desc=$3
    [ -n "$rev" ] || return 0
    if ! jj -R "$root" log --no-graph -r "$rev" -T 'change_id.short()' --no-pager >/dev/null 2>&1; then
        return 0
    fi
    if ! jj_change_empty "$root" "$rev"; then
        printf 'jj workspace change is not empty; leaving it intact: %s\n' "$rev" >&2
        return 1
    fi
    desc=$(jj_change_description "$root" "$rev")
    if [ "$desc" != "$expected_desc" ]; then
        printf 'jj workspace change description did not match; leaving it intact: %s\n' "$rev" >&2
        return 1
    fi
    jj -R "$root" abandon "$rev" >/dev/null 2>&1 || {
        printf 'could not abandon jj workspace change %s\n' "$rev" >&2
        return 1
    }
}

crew_field() {
    slug=$1
    field=$2
    meta=$(crew_meta_path "$slug")
    [ -f "$meta" ] || {
        printf 'unknown crew: %s\n' "$slug" >&2
        exit 1
    }
    awk -F= -v f="$field" '$1==f {sub($1"=", ""); print; exit}' "$meta"
}

crew_worktree_clean() {
    worktree=$1
    [ -d "$worktree" ] || return 2
    if [ -e "$worktree/.jj" ] && command -v jj >/dev/null 2>&1; then
        jj -R "$worktree" status --no-pager 2>/dev/null | grep -q '^The working copy has no changes\.$'
    else
        [ -z "$(git -C "$worktree" status --porcelain 2>/dev/null)" ]
    fi
}

# Deliver the startup prompt to a freshly spawned crew pane and PROVE it landed
# AND was accepted. A crew that boots without its brief is useless, so an
# unconfirmed delivery is a hard failure (non-zero return) that the caller must
# turn into a failed spawn - never a warning.
#
# Crews run through `herdr pane run` (this herdr cannot attach a named agent to
# an existing pane), so the prompt is submitted as raw pane input - the same
# path `ak crew-send` uses. Readiness is Herdr's own agent state: "idle"/"done"
# means the agent is sitting at its prompt. Acceptance is then proven by the
# agent LEAVING that state, because visible text alone is not enough - while the
# TUI is still settling, the submit Enter can be swallowed and leave the prompt
# sitting in the input box with the agent still idle. In that case the Enter is
# re-pressed until the agent starts working.
#
# Failure modes are kept distinct: "no agent registered" and "pane not ready"
# are reported separately from a send that cannot be confirmed. $4 is the herdr
# agent kind the crew command resolves to ("" for an arbitrary command, which
# has no agent state to check); $5 is a substring that must become visible in
# the pane once the prompt lands. $6 is a single overall wall-clock deadline
# (ms) bounding BOTH phases so a broken pane can never hang spawn forever.
crew_deliver_startup_prompt() {
    session=$1
    pane=$2
    prompt=$3
    expect_kind=$4
    marker=$5
    overall_budget=${6:-120000}
    ready_budget=${AK_CREW_READY_TIMEOUT:-15000}
    submit_retry=2000
    # The readiness phase may not outlive the overall deadline.
    [ "$ready_budget" -gt "$overall_budget" ] && ready_budget=$overall_budget

    elapsed=0
    status=
    agent_pane=0
    while :; do
        status=$(backend_agent_status "$session" "$pane")
        case "$status" in
        idle | done)
            agent_pane=1
            break
            ;;
        esac
        if [ "$elapsed" -ge "$ready_budget" ]; then
            if [ -n "$expect_kind" ]; then
                if [ "$status" = agent_not_found ] || [ "$status" = unknown ]; then
                    printf 'error: no %s agent registered in crew pane %s after %sms (last status: %s)\n' \
                        "$expect_kind" "$pane" "$ready_budget" "$status" >&2
                else
                    printf 'error: crew pane %s never became input-ready after %sms (last status: %s)\n' \
                        "$pane" "$ready_budget" "$status" >&2
                fi
                return 1
            fi
            printf 'note: no herdr agent detected in crew pane %s after %sms (status: %s); submitting the startup prompt as raw pane input\n' \
                "$pane" "$ready_budget" "$status" >&2
            break
        fi
        sleep 0.5
        elapsed=$((elapsed + 500))
    done

    before=$status
    if ! backend_pane_send "$session" "$pane" "$prompt"; then
        printf 'error: could not send the startup prompt to crew pane %s\n' "$pane" >&2
        return 1
    fi

    since_submit=0
    while :; do
        status=$(backend_agent_status "$session" "$pane")
        if [ "$agent_pane" = 1 ]; then
            # Acceptance is the agent actively processing the prompt
            # (working/blocked), or having completed a turn it would not have
            # started otherwise (idle -> done). A vanished agent is the
            # opposite of acceptance, and must not be mistaken for a change.
            case "$status" in
            working | blocked) return 0 ;;
            done)
                [ "$before" = idle ] && return 0
                ;;
            agent_not_found | unknown | '')
                printf 'error: crew agent vanished from pane %s before accepting its startup prompt (last status: %s)\n' "$pane" "$status" >&2
                return 1
                ;;
            esac
            # Still idle with the prompt sitting in its input box: the submit
            # Enter was swallowed while the TUI was settling. Nudge it again.
            if [ "$since_submit" -ge "$submit_retry" ]; then
                backend_pane_submit "$session" "$pane" || true
                since_submit=0
            fi
        elif [ -n "$marker" ] && backend_pane_contains "$session" "$pane" "$marker"; then
            # No agent reports acceptance, so the best available proof is the
            # prompt text showing up in the pane.
            return 0
        fi
        if [ "$elapsed" -ge "$overall_budget" ]; then
            printf 'error: startup prompt was sent to crew pane %s but delivery could not be confirmed within %sms (last status: %s)\n' \
                "$pane" "$overall_budget" "$status" >&2
            return 1
        fi
        sleep 0.5
        elapsed=$((elapsed + 500))
        since_submit=$((since_submit + 500))
    done
}

crew_spawn() {
    [ "$#" -ge 2 ] || {
        printf 'usage: ak crew-spawn <slug> <brief text...>\n' >&2
        exit 2
    }
    need herdr >/dev/null
    need jq >/dev/null
    slug=$(slugify "$1")
    shift
    [ -n "$slug" ] || {
        printf 'invalid slug\n' >&2
        exit 2
    }
    brief=$*
    root=$(repo_root)
    ensure_runtime_ignored
    vcs=$(repo_vcs)
    ak_cmd=$(self_path)
    crew_dir="$root/.agent-kit/crew/$slug"
    worktree="$root/.agent-kit/worktrees/$slug"
    branch="ak/$slug"
    [ ! -e "$crew_dir" ] || {
        printf 'crew already exists: %s\n' "$slug" >&2
        exit 1
    }
    [ ! -e "$worktree" ] || {
        printf 'worktree already exists: %s\n' "$worktree" >&2
        exit 1
    }
    lock_acquire "$root/.agent-kit/locks/crew-spawn.lock"
    mkdir -p "$crew_dir" "$root/.agent-kit/worktrees"
    jj_change=
    if [ "$vcs" = jj ]; then
        jj -R "$root" workspace add --name "$slug" -m "agent-kit crew: $slug" "$worktree" >/dev/null
        jj_change=$(jj_current_change_id "$worktree")
    else
        need git >/dev/null
        if git -C "$root" show-ref --verify --quiet "refs/heads/$branch"; then
            printf 'branch already exists: %s\n' "$branch" >&2
            exit 1
        fi
        git -C "$root" worktree add -b "$branch" "$worktree" HEAD >/dev/null
    fi
    lock_release
    # Stamp a worker role marker inside the worktree so the crew agent can
    # self-detect its role (ak role -> worker) and wake the primary from its
    # own cwd (ak reply / ak done). ".agent-kit/" is gitignored, so this marker
    # never makes the worktree look dirty in git or jj.
    primary_session_val=$(primary_field_at "$root" session 2>/dev/null || printf '%s' "${AK_HERDR_SESSION:-default}")
    primary_target_val=$(primary_field_at "$root" target 2>/dev/null || true)
    mkdir -p "$worktree/.agent-kit"
    cat >"$worktree/.agent-kit/role" <<EOF
role=worker
slug=$slug
primary_repo=$root
primary_session=$primary_session_val
primary_target=$primary_target_val
created_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)
EOF
    cat >"$crew_dir/brief.md" <<EOF
# Crew task: $slug

## Brief

$brief

## Contract

- You are a WORKER. Run \`$ak_cmd role\` to confirm (it prints "worker" here).
- Read project instructions before changing files.
- Work only inside this isolated worktree: $worktree
- Make the smallest correct change.
- Run relevant checks.
- Do not merge, force-push, reset, clean, or discard work.
- Log spend when asked, at meaningful milestones, and before handback with: $ak_cmd crew-cost $slug <usd|unknown> "model/session, token estimate if known, and what work the spend covered" (run from "$root", or use \`cd "$root"\`).
- Talk to the primary mid-task with: \`$ak_cmd reply "question or status"\` (works from this worktree; it wakes the primary).
- When finished, run from this worktree: \`$ak_cmd done "summary, files changed, checks, cost notes, blockers"\`. This writes the report and wakes the primary.
- Read the shared chat transcript any time with: \`$ak_cmd chat\`.
EOF
    cat >"$crew_dir/report.template.md" <<EOF
# Crew report: $slug

## Outcome

## Files changed

## Checks

## Cost

## Notes
EOF
    printf 'state=running\nstarted_at=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >"$crew_dir/state"
    cmd=${AK_CREW_COMMAND:-pi}
    crew_agent_name=$(slugify "crew-$slug" | cut -c1-32)
    # Write a discoverable meta BEFORE the herdr tab is created, so an aborted
    # spawn (tab/pane failure) does not leave an orphan worktree that
    # crew-status / crew-audit / crew-finish cannot see. The herdr_* fields are
    # filled in below once the tab exists.
    cat >"$crew_dir/meta" <<EOF
slug=$slug
repo=$root
worktree=$worktree
branch=$branch
vcs=$vcs
jj_change=$jj_change
brief=$crew_dir/brief.md
command=$cmd
created_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)
EOF
    AK_TAB_AGENT_NAME=$crew_agent_name herdr_tab_create "crew-$slug" "$worktree" "$cmd"
    cat >"$crew_dir/meta" <<EOF
slug=$slug
repo=$root
worktree=$worktree
branch=$branch
vcs=$vcs
jj_change=$jj_change
brief=$crew_dir/brief.md
herdr_session=$HERDR_CREATED_SESSION
herdr_workspace=$HERDR_CREATED_WORKSPACE
herdr_tab=$HERDR_CREATED_TAB
herdr_pane=$HERDR_CREATED_PANE
command=$cmd
created_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)
EOF
    if [ -n "${HERDR_CREATED_PANE:-}" ]; then
        startup_prompt="Read $crew_dir/brief.md and begin. When ready, hand back from this worktree with: $ak_cmd done \"summary, files changed, checks, blockers\""
        timeout=${AK_CREW_STARTUP_TIMEOUT:-120000}
        # The crew must receive its brief or the spawn must fail: an
        # unconfirmed delivery exits non-zero instead of printing "crew
        # spawned" over a silently deaf crew.
        if ! crew_deliver_startup_prompt "$HERDR_CREATED_SESSION" "$HERDR_CREATED_PANE" "$startup_prompt" "${HERDR_CREATED_AGENT_KIND:-}" "$crew_dir/brief.md" "$timeout"; then
            printf 'error: crew %s was created in pane %s but its startup prompt was NOT delivered; the crew is running without its brief.\n' "$slug" "$HERDR_CREATED_PANE" >&2
            printf 'error: crew state is at %s; deliver the brief manually with:\n  %s crew-send %s "Read %s and begin."\n' "$crew_dir" "$ak_cmd" "$slug" "$crew_dir/brief.md" >&2
            printf 'error: once handled, remove the crew with: %s crew-finish %s\n' "$ak_cmd" "$slug" >&2
            exit 1
        fi
    fi
    printf 'crew spawned: %s\n' "$slug"
    printf 'worktree: %s\n' "$worktree"
    printf 'brief: %s\n' "$crew_dir/brief.md"
}

crew_status() {
    base=$(crew_base)
    [ -d "$base" ] || {
        printf 'no crew state\n'
        return 0
    }
    printf 'slug\tstate\tworktree\tbranch\treport\n'
    for meta in "$base"/*/meta; do
        [ -f "$meta" ] || continue
        slug=$(awk -F= '$1=="slug" {print $2}' "$meta")
        pane=$(awk -F= '$1=="herdr_pane" {print $2}' "$meta")
        session=$(awk -F= '$1=="herdr_session" {print $2}' "$meta")
        worktree=$(awk -F= '$1=="worktree" {print $2}' "$meta")
        branch=$(awk -F= '$1=="branch" {print $2}' "$meta")
        report=$(crew_report_path "$slug")
        state=$(backend_agent_status "$session" "$pane")
        [ -n "$state" ] || state=unknown
        if [ -n "$worktree" ] && [ -d "$worktree" ]; then
            if crew_worktree_clean "$worktree"; then
                cleanliness=clean
            else
                cleanliness=dirty
            fi
        else
            cleanliness=missing
        fi
        if [ -f "$report" ]; then
            report_state=yes
        else
            report_state=no
        fi
        printf '%s\t%s/%s\t%s\t%s\t%s\n' "$slug" "$state" "$cleanliness" "$worktree" "$branch" "$report_state"
    done
}

crew_audit() {
    base=$(crew_base)
    [ -d "$base" ] || {
        printf 'no crew state\n'
        return 0
    }
    for meta in "$base"/*/meta; do
        [ -f "$meta" ] || continue
        slug=$(awk -F= '$1=="slug" {print $2}' "$meta")
        pane=$(awk -F= '$1=="herdr_pane" {print $2}' "$meta")
        session=$(awk -F= '$1=="herdr_session" {print $2}' "$meta")
        worktree=$(awk -F= '$1=="worktree" {print $2}' "$meta")
        branch=$(awk -F= '$1=="branch" {print $2}' "$meta")
        report=$(crew_report_path "$slug")
        state=$(backend_agent_status "$session" "$pane")
        [ -n "$state" ] || state=unknown
        if [ -n "$worktree" ] && [ -d "$worktree" ]; then
            if crew_worktree_clean "$worktree"; then
                cleanliness=clean
            else
                cleanliness=dirty
            fi
        else
            cleanliness=missing
        fi
        if [ -f "$report" ]; then
            report_state=ready
        else
            report_state=missing
        fi
        printf '%s\n' "- $slug: state=$state, worktree=$cleanliness, branch=$branch, report=$report_state"
        if [ "$cleanliness" = dirty ]; then
            printf '  worktree: %s\n' "$worktree"
        fi
    done
}

crew_checkpoint() {
  [ "$#" -ge 2 ] || { printf 'usage: ak crew-checkpoint <slug> <item text...>\n' >&2; exit 2; }
  slug=$(slugify "$1")
  shift
  root=$(crew_root)
  meta="$root/.agent-kit/crew/$slug/meta"
  [ -f "$meta" ] || { printf 'unknown crew: %s\n' "$slug" >&2; exit 1; }
  prog="$root/.agent-kit/crew/$slug/progress.tsv"
  mkdir -p "$(dirname "$prog")"
  if [ ! -f "$prog" ]; then
    printf 'timestamp\titem\n' >"$prog"
  fi
  item=$*
  item=$(printf '%s' "$item" | tr '\t\n' '  ')
  printf '%s\t%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$item" >>"$prog"
  printf 'crew checkpoint: %s\n' "$slug"
}

crew_cost() {
    [ "$#" -ge 2 ] || {
        printf 'usage: ak crew-cost <slug> <usd|unknown> [note...]\n' >&2
        exit 2
    }
    slug=$(slugify "$1")
    amount=$2
    shift 2
    root=$(crew_root)
    meta="$root/.agent-kit/crew/$slug/meta"
    [ -f "$meta" ] || {
        printf 'unknown crew: %s\n' "$slug" >&2
        exit 1
    }
    currency=${AK_COST_CURRENCY:-USD}
    cost="$root/.agent-kit/crew/$slug/cost.tsv"
    mkdir -p "$(dirname "$cost")"
    if [ ! -f "$cost" ]; then
        printf 'timestamp\tslug\tamount\tcurrency\tprovider\tmodel\tsession\tnote\n' >"$cost"
    fi
    note=$*
    note=$(printf '%s' "$note" | tr '\t\n' '  ')
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
        "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
        "$slug" \
        "$amount" \
        "$currency" \
        "${PI_PROVIDER:-${AK_PROVIDER:-unknown}}" \
        "${PI_MODEL:-${AK_MODEL:-unknown}}" \
        "${PI_SESSION_ID:-unknown}" \
        "$note" >>"$cost"
    printf 'crew cost logged: %s\n' "$slug"
    printf 'cost: %s\n' "$cost"
}

crew_cost_summary() {
    base=$(crew_base)
    [ -d "$base" ] || {
        printf 'no crew state\n'
        return 0
    }
    found=0
    total=0
    printf 'slug\tentries\tknown_total\tunknown_entries\tcurrency\n'
    for meta in "$base"/*/meta; do
        [ -f "$meta" ] || continue
        slug=$(awk -F= '$1=="slug" {print $2}' "$meta")
        cost=$(crew_cost_path "$slug")
        [ -f "$cost" ] || continue
        found=1
        awk -F '\t' -v slug="$slug" '
      NR == 1 {next}
      $3 ~ /^[0-9]+([.][0-9]+)?$/ {sum += $3; known += 1; currency = $4; next}
      {unknown += 1; if (currency == "") currency = $4}
      END {printf "%s\t%d\t%.6f\t%d\t%s\n", slug, known + unknown, sum, unknown, (currency == "" ? "USD" : currency)}
    ' "$cost"
        crew_sum=$(awk -F '\t' 'NR > 1 && $3 ~ /^[0-9]+([.][0-9]+)?$/ {sum += $3} END {printf "%.6f", sum}' "$cost")
        total=$(awk -v a="$total" -v b="$crew_sum" 'BEGIN {printf "%.6f", a + b}')
    done
    [ "$found" = 1 ] || {
        printf 'no crew cost logs\n'
        return 0
    }
    printf 'TOTAL\t-\t%.6f\t-\t%s\n' "$total" "${AK_COST_CURRENCY:-USD}"
}

crew_cost_prompt() {
    base=$(crew_base)
    [ -d "$base" ] || {
        printf 'no crew state\n'
        return 0
    }
    ak_cmd=$(self_path)
    custom=$*
    sent=0
    for meta in "$base"/*/meta; do
        [ -f "$meta" ] || continue
        slug=$(awk -F= '$1=="slug" {print $2}' "$meta")
        pane=$(awk -F= '$1=="herdr_pane" {print $2}' "$meta")
        session=$(awk -F= '$1=="herdr_session" {print $2}' "$meta")
        [ -n "$pane" ] && [ -n "$session" ] || continue
        message="Please log current estimated spend with: $ak_cmd crew-cost $slug <usd|unknown> \"model/session, token estimate if known, and what work the spend covered\". ${custom:-}"
        backend_pane_send "$session" "$pane" "$message" >/dev/null 2>&1 || continue
        sent=$((sent + 1))
    done
    printf 'cost prompts sent: %s\n' "$sent"
}

crew_report() {
    [ "$#" -ge 2 ] || {
        printf 'usage: ak crew-report <slug> <message text...>\n' >&2
        exit 2
    }
    slug=$(slugify "$1")
    shift
    root=$(crew_root)
    chat_append "$root" "$slug" worker "report: $*"
    crew_report_core "$root" "$slug" "$*"
}

crew_resume() {
  [ "$#" -ge 1 ] || { printf 'usage: ak crew-resume <slug>\n' >&2; exit 2; }
  slug=$(slugify "$1")
  meta=$(crew_meta_path "$slug")
  [ -f "$meta" ] || { printf 'unknown crew: %s\n' "$slug" >&2; exit 1; }
  prog=$(crew_progress_path "$slug")
  if [ ! -f "$prog" ] || [ $(wc -l <"$prog") -le 1 ]; then
    printf 'no checkpoints for crew: %s\n' "$slug"
  else
    printf '## Progress: %s\n\n' "$slug"
    awk -F'\t' 'NR==1 {printf "%-20s  %s\n", $1, $2; printf "%-20s  %s\n", "--------------------", "-----"; next} {printf "%-20s  %s\n", $1, $2}' "$prog"
  fi
}

crew_finish() {
    [ "$#" -ge 1 ] || {
        printf 'usage: ak crew-finish <slug> [report text...]\n' >&2
        exit 2
    }
    slug=$(slugify "$1")
    shift
    root=$(repo_root)
    vcs=$(repo_vcs)
    ak_cmd=$(self_path)
    meta=$(crew_meta_path "$slug")
    [ -f "$meta" ] || {
        printf 'unknown crew: %s\n' "$slug" >&2
        exit 1
    }
    worktree=$(crew_field "$slug" worktree)
    branch=$(crew_field "$slug" branch)
    tab=$(crew_field "$slug" herdr_tab)
    session=$(crew_field "$slug" herdr_session)
    report=$(crew_report_path "$slug")
    if [ "$#" -gt 0 ]; then
        mkdir -p "$(dirname "$report")"
        cat >"$report" <<EOF
# Crew report: $slug

$*
EOF
    elif [ ! -f "$report" ]; then
        printf 'report missing for crew: %s\n' "$slug" >&2
        printf 'write one with: %s crew-report %s "summary..."\n' "$ak_cmd" "$slug" >&2
        exit 1
    fi
    if ! crew_worktree_clean "$worktree"; then
        printf 'crew worktree is dirty; review before finishing: %s\n' "$worktree" >&2
        if [ "$vcs" = jj ]; then
            jj -R "$worktree" status --no-pager >&2 || true
        else
            git -C "$worktree" status --short >&2 || true
        fi
        exit 1
    fi
    jj_change=
    if [ "$vcs" = jj ]; then
        jj_change=$(crew_field "$slug" jj_change 2>/dev/null || true)
        [ -n "$jj_change" ] || jj_change=$(jj_current_change_id "$worktree" 2>/dev/null || true)
        if [ -n "$jj_change" ] && jj -R "$root" log --no-graph -r "$jj_change" -T 'change_id.short()' --no-pager >/dev/null 2>&1; then
            if ! jj_change_empty "$root" "$jj_change"; then
                printf 'jj workspace change is not empty; leaving crew intact: %s\n' "$jj_change" >&2
                exit 1
            fi
            desc=$(jj_change_description "$root" "$jj_change")
            if [ "$desc" != "agent-kit crew: $slug" ]; then
                printf 'jj workspace change description did not match; leaving crew intact: %s\n' "$jj_change" >&2
                exit 1
            fi
        fi
    fi
    if command -v herdr >/dev/null 2>&1 && [ -n "$tab" ] && [ -n "$session" ]; then
        backend_tab_close "$session" "$tab" || {
            printf 'could not close crew tab for %s\n' "$slug" >&2
            exit 1
        }
    fi
    if [ "$vcs" = jj ]; then
        jj -R "$root" workspace forget "$slug" >/dev/null 2>&1 || {
            printf 'could not forget jj workspace %s\n' "$slug" >&2
            exit 1
        }
        jj_abandon_empty_change "$root" "$jj_change" "agent-kit crew: $slug"
        rm -rf "$worktree" || {
            printf 'could not remove workspace directory %s\n' "$worktree" >&2
            exit 1
        }
    else
        git_commits=
        if git -C "$root" show-ref --verify --quiet "refs/heads/$branch"; then
            others=$(git -C "$root" for-each-ref --format='%(refname)' | grep -v "^refs/heads/$branch$" || true)
            git_commits=$(git -C "$root" rev-list "$branch" --not $others 2>/dev/null || true)
        fi
        git -C "$root" worktree remove "$worktree" >/dev/null 2>&1 || {
            printf 'could not remove worktree %s\n' "$worktree" >&2
            exit 1
        }
        git -C "$root" branch -D "$branch" >/dev/null 2>&1 || true
        if [ -n "$git_commits" ]; then
            unreachable=$(git -C "$root" fsck --unreachable --no-reflogs 2>/dev/null | awk '$2=="commit"{print $3}' | sort -u)
            prune_ok=1
            for c in $git_commits; do
                if ! printf '%s\n' "$unreachable" | grep -qxF "$c"; then
                    printf 'warning: crew commit still referenced elsewhere; skipping prune: %s\n' "$c" >&2
                    prune_ok=0
                    break
                fi
            done
            if [ "$prune_ok" = 1 ]; then
                git -C "$root" prune --expire=now >/dev/null 2>&1 || true
                printf 'pruned crew commits: %s\n' "$git_commits"
            fi
        fi
    fi
    printf 'state=done\nfinished_at=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >"$(dirname "$meta")/state"
    printf 'crew finished: %s\n' "$slug"
    printf 'report: %s\n' "$report"
}

crew_meta_field() {
    crew_field "$1" "$2"
}

crew_peek() {
    [ "$#" -ge 1 ] || {
        printf 'usage: ak crew-peek <slug> [lines]\n' >&2
        exit 2
    }
    slug=$(slugify "$1")
    lines=${2:-80}
    pane=$(crew_meta_field "$slug" herdr_pane)
    session=$(crew_meta_field "$slug" herdr_session)
    backend_pane_read "$session" "$pane" "$lines"
}

crew_send() {
    [ "$#" -ge 2 ] || {
        printf 'usage: ak crew-send <slug> <message text...>\n' >&2
        exit 2
    }
    slug=$(slugify "$1")
    shift
    pane=$(crew_meta_field "$slug" herdr_pane)
    session=$(crew_meta_field "$slug" herdr_session)
    chat_append "$(repo_root)" "$slug" primary "$*"
    backend_pane_send "$session" "$pane" "$*"
}

# --- backend seam -----------------------------------------------------------
# All session-backend interactions go through backend_* wrappers so a future
# backend (tmux, zellij, ...) can be added by implementing these cases without
# touching the command functions. Only "herdr" is implemented today.

backend_kind() {
    printf '%s' "${AK_BACKEND:-herdr}"
}

backend_require() {
    case "$(backend_kind)" in
    herdr)
        need herdr >/dev/null
        ;;
    *)
        printf 'unsupported AK_BACKEND: %s (only "herdr" is implemented)\n' "$(backend_kind)" >&2
        exit 1
        ;;
    esac
}

backend_notify() {
    session=$1
    title=$2
    body=$3
    [ "${AK_NO_NOTIFY:-0}" = 1 ] && return 0
    case "$(backend_kind)" in
    herdr)
        command -v herdr >/dev/null 2>&1 || return 0
        herdr notification show "$title" --body "$body" --sound done --session "$session" >/dev/null 2>&1 || true
        ;;
    *) return 0 ;;
    esac
}

backend_wake() {
    session=$1
    target=$2
    message=$3
    case "$(backend_kind)" in
    herdr)
        command -v herdr >/dev/null 2>&1 || return 1
        # Probe the target's agent liveness first. Where an agent surface is
        # available, submit via `herdr agent send` (literal text honoring the
        # pane's bracketed-paste mode) plus an explicit Enter. A plain
        # non-agent shell pane is the only fallback for raw pane input, and
        # that fallback is logged so a dead agent is never silently reported
        # as a successful wake.
        status=$(backend_agent_status "$session" "$target")
        case "$status" in
        idle | working | blocked | done)
            if ! herdr agent send "$target" "$message" --session "$session" >/dev/null 2>&1; then
                printf 'error: wake send failed for agent target %s\n' "$target" >&2
                return 1
            fi
            if ! herdr pane send-keys "$target" enter --session "$session" >/dev/null 2>&1; then
                printf 'error: wake submitted to agent %s but the submit key was not confirmed\n' "$target" >&2
                return 2
            fi
            # Delivering the Enter keystroke only proves the key reached the
            # pane, not that the agent accepted the prompt. Wait for the agent
            # to enter the working state so a swallowed Enter or a wedged agent
            # is reported as unconfirmed instead of a false success. An agent
            # already mid-turn is already working, so the wait returns at once
            # and the steer is queued for the agent's next turn.
            if ! herdr agent wait "$target" --status working --timeout "${AK_WAKE_ACCEPT_TIMEOUT:-8000}" --session "$session" >/dev/null 2>&1; then
                printf 'error: wake was submitted to agent %s but it did not enter working state within %sms (not confirmed accepted)\n' "$target" "${AK_WAKE_ACCEPT_TIMEOUT:-8000}" >&2
                return 2
            fi
            return 0
            ;;
        *)
            printf 'note: no agent registered at target %s (status: %s); using raw pane input fallback\n' "$target" "$status" >&2
            if ! herdr pane send-text "$target" "$message" --session "$session" >/dev/null 2>&1; then
                printf 'error: raw pane wake send failed for target %s (no agent registered)\n' "$target" >&2
                return 1
            fi
            if ! herdr pane send-keys "$target" enter --session "$session" >/dev/null 2>&1; then
                printf 'error: raw pane wake submitted to %s but the submit key was not confirmed\n' "$target" >&2
                return 2
            fi
            return 0
            ;;
        esac
        ;;
    *) backend_require ;;
    esac
}

backend_pane_read() {
    session=$1
    pane=$2
    lines=$3
    case "$(backend_kind)" in
    herdr) herdr pane read "$pane" --source recent --lines "$lines" --session "$session" ;;
    *) backend_require ;;
    esac
}

backend_pane_send() {
    session=$1
    pane=$2
    message=$3
    case "$(backend_kind)" in
    herdr)
        herdr pane send-text "$pane" "$message" --session "$session" || return 1
        backend_pane_submit "$session" "$pane" || return 1
        ;;
    *) backend_require ;;
    esac
}

# Press Enter in a pane, submitting whatever is sitting on its input line.
backend_pane_submit() {
    session=$1
    pane=$2
    case "$(backend_kind)" in
    herdr) herdr pane send-keys "$pane" enter --session "$session" ;;
    *) backend_require ;;
    esac
}

# Whether a substring is visible in a pane's recent buffer. Newlines are
# stripped first so text wrapped by the pane's renderer still matches.
backend_pane_contains() {
    session=$1
    pane=$2
    needle=$3
    buffer=$(backend_pane_read "$session" "$pane" 200 2>/dev/null | tr -d '\r\n' || true)
    [ -n "$buffer" ] && printf '%s' "$buffer" | grep -qF -- "$needle"
}

backend_agent_status() {
    session=$1
    pane=$2
    case "$(backend_kind)" in
    herdr)
        [ -n "$pane" ] && [ -n "$session" ] && command -v herdr >/dev/null 2>&1 || {
            printf 'unknown'
            return 0
        }
        status=$(herdr agent get "$pane" --session "$session" 2>&1 | jq -r '.result.agent.agent_status // .error.code // empty' 2>/dev/null || true)
        # A missing pane (empty/errored reply) is reported as unknown rather
        # than an empty string, so callers can always match on a status.
        [ -n "$status" ] || status=unknown
        printf '%s\n' "$status"
        ;;
    *) printf 'unknown' ;;
    esac
}

backend_tab_close() {
    session=$1
    tab=$2
    case "$(backend_kind)" in
    herdr) herdr tab close "$tab" --session "$session" >/dev/null 2>&1 ;;
    *) backend_require ;;
    esac
}

# --- roles ------------------------------------------------------------------

role_marker_path() {
    printf '%s/.agent-kit/role' "$(repo_root)"
}

role_field() {
    marker=$1
    field=$2
    awk -F= -v f="$field" '$1==f {print substr($0, index($0,"=")+1); exit}' "$marker"
}

is_worker() {
    marker=$(role_marker_path 2>/dev/null) || return 1
    [ -f "$marker" ] && grep -q '^role=worker$' "$marker" 2>/dev/null
}

ak_role() {
    if is_worker; then
        printf 'worker\n'
    else
        printf 'primary\n'
    fi
}

require_worker_marker() {
    if ! is_worker; then
        printf 'not a worker checkout: no worker role marker here.\n' >&2
        printf 'run this from inside a crew worktree created by ak crew-spawn.\n' >&2
        exit 1
    fi
    role_marker_path
}

ak_whoami() {
    role=$(ak_role)
    printf 'role: %s\n' "$role"
    if [ "$role" = worker ]; then
        marker=$(role_marker_path)
        printf 'slug: %s\n' "$(role_field "$marker" slug)"
        printf 'primary_repo: %s\n' "$(role_field "$marker" primary_repo)"
        printf 'primary_session: %s\n' "$(role_field "$marker" primary_session)"
        printf 'primary_target: %s\n' "$(role_field "$marker" primary_target)"
    else
        if primary_target >/dev/null 2>&1; then
            printf 'primary_target: %s\n' "$(primary_target)"
            printf 'primary_session: %s\n' "$(primary_session 2>/dev/null || printf '%s' "${AK_HERDR_SESSION:-default}")"
        else
            printf 'primary_target: (not registered; run ak primary-set)\n'
        fi
    fi
    printf 'backend: %s\n' "$(backend_kind)"
    printf 'phase: %s\n' "$(phase_current 2>/dev/null || printf '(unset)')"
}

# --- phase ------------------------------------------------------------------

phase_path() {
    printf '%s/phase' "$(agentkit_dir)"
}

phase_current() {
    p=$(phase_path)
    [ -f "$p" ] || return 1
    awk -F= '$1=="phase" {print substr($0, index($0,"=")+1); exit}' "$p"
}

phase_valid() {
    case "$1" in
    research | planning | awaiting-approval | implementing | testing | done) return 0 ;;
    *) return 1 ;;
    esac
}

phase_show() {
    if cur=$(phase_current 2>/dev/null); then
        printf '%s\n' "$cur"
    else
        printf '(unset)\n'
    fi
}

phase_set() {
    [ "$#" -ge 1 ] || {
        printf 'usage: ak phase set <phase>\n' >&2
        printf 'phases: research planning awaiting-approval implementing testing done\n' >&2
        exit 2
    }
    new=$1
    if ! phase_valid "$new"; then
        printf 'invalid phase: %s\n' "$new" >&2
        printf 'phases: research planning awaiting-approval implementing testing done\n' >&2
        exit 2
    fi
    ensure_runtime_ignored
    mkdir -p "$(agentkit_dir)"
    cat >"$(phase_path)" <<EOF
phase=$new
updated_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)
EOF
    printf 'phase: %s\n' "$new"
}

ak_phase() {
    sub=${1:-show}
    case "$sub" in
    show)
        phase_show
        ;;
    set)
        shift 2>/dev/null || true
        phase_set "$@"
        ;;
    *)
        # allow "ak phase implementing" shorthand for "ak phase set implementing"
        phase_set "$sub"
        ;;
    esac
}

# --- primary/worker chatbox -------------------------------------------------

chat_path() {
    printf '%s/.agent-kit/crew/%s/chat.log' "$1" "$2"
}

chat_append() {
    root=$1
    slug=$2
    who=$3
    shift 3
    msg=$*
    log=$(chat_path "$root" "$slug")
    mkdir -p "$(dirname "$log")" 2>/dev/null || return 0
    msg=$(printf '%s' "$msg" | tr '\t\n' '  ')
    printf '%s\t%s\t%s\n' "$who" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$msg" >>"$log"
}

chat_render() {
    log=$1
    lines=${2:-200}
    [ -f "$log" ] || {
        printf 'no chat log: %s\n' "$log"
        return 0
    }
    tail -n "$lines" "$log" | while IFS="$(printf '\t')" read -r who ts msg; do
        printf '[%s] %s: %s\n' "$ts" "$who" "$msg"
    done
}

ak_chat() {
    if is_worker; then
        marker=$(role_marker_path)
        root=$(role_field "$marker" primary_repo)
        slug=$(role_field "$marker" slug)
        lines=${1:-200}
        chat_render "$(chat_path "$root" "$slug")" "$lines"
        return 0
    fi
    [ "$#" -ge 1 ] || {
        printf 'usage (primary): ak chat <slug> [lines]\n' >&2
        exit 2
    }
    slug=$(slugify "$1")
    lines=${2:-200}
    root=$(repo_root)
    chat_render "$(chat_path "$root" "$slug")" "$lines"
}

# reply: worker -> primary, mid-task (no completion). Wakes the primary.
ak_reply() {
    [ "$#" -ge 1 ] || {
        printf 'usage: ak reply <message text...>\n' >&2
        exit 2
    }
    marker=$(require_worker_marker)
    slug=$(role_field "$marker" slug)
    proot=$(role_field "$marker" primary_repo)
    psession=$(role_field "$marker" primary_session)
    ptarget=$(role_field "$marker" primary_target)
    msg=$*
    chat_append "$proot" "$slug" worker "$msg"
    if [ "${AK_NO_WAKE:-0}" = 1 ]; then
        printf 'replied (logged to chat); wake disabled via AK_NO_WAKE\n'
    elif [ -n "$ptarget" ]; then
        if backend_wake "$psession" "$ptarget" "crew $slug: $msg"; then
            printf 'replied to primary and sent wake: %s\n' "$slug"
        else
            rc=$?
            mark_wake_undelivered "$proot" "$slug"
            printf 'error: reply was logged for %s but the primary wake was NOT delivered (exit %s); see above\n' "$slug" "$rc" >&2
            exit "$rc"
        fi
    else
        printf 'replied (logged to chat); no primary target recorded to wake\n'
    fi
}

# done: worker completion. Writes the report against the primary repo and wakes
# the primary. Runnable from the worker's own worktree.
ak_done() {
    [ "$#" -ge 1 ] || {
        printf 'usage: ak done <message text...>\n' >&2
        exit 2
    }
    marker=$(require_worker_marker)
    slug=$(role_field "$marker" slug)
    proot=$(role_field "$marker" primary_repo)
    [ -n "$proot" ] && [ -d "$proot" ] || {
        printf 'recorded primary_repo is missing: %s\n' "$proot" >&2
        exit 1
    }
    chat_append "$proot" "$slug" worker "$*"
    crew_report_core "$proot" "$slug" "$*"
}

# --- root-scoped primary lookup (works from any checkout) --------------------

primary_field_at() {
    root=$1
    field=$2
    p="$root/.agent-kit/primary"
    [ -f "$p" ] || return 1
    awk -F= -v f="$field" '$1==f {print substr($0, index($0,"=")+1); exit}' "$p"
}

# crew_report_core: shared report + wake path, parameterized by the PRIMARY
# repo root so it works whether called by the primary (repo_root) or by a
# worker via `ak done` (primary_repo from the worker role marker).
crew_report_core() {
    root=$1
    slug=$2
    shift 2
    message=$*
    crewdir="$root/.agent-kit/crew/$slug"
    meta="$crewdir/meta"
    [ -f "$meta" ] || {
        printf 'unknown crew: %s\n' "$slug" >&2
        exit 1
    }
    report="$crewdir/report.md"
    mkdir -p "$crewdir"
    {
        printf '# Crew report: %s\n\n' "$slug"
        printf '## Outcome\n\n%s\n\n' "$message"
        printf '## Files changed\n\n- see worktree\n\n'
        printf '## Checks\n\n- pending or included above\n\n'
        printf '## Cost\n\n- see cost.tsv or included above\n\n'
        printf '## Notes\n\n- reported_at: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    } >"$report"
    reported_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)
    printf 'state=reported\nreported_at=%s\n' "$reported_at" >"$crewdir/state"
    inbox="$root/.agent-kit/inbox"
    mkdir -p "$inbox"
    printf '# Crew update: %s\n\n- reported_at: %s\n- report: %s\n\n%s\n' "$slug" "$reported_at" "$report" "$message" >"$inbox/${reported_at}-$slug.md"
    session=$(primary_field_at "$root" session 2>/dev/null || printf '%s' "${AK_HERDR_SESSION:-default}")
    inject=$(primary_field_at "$root" inject 2>/dev/null || printf 1)
    target=$(primary_field_at "$root" target 2>/dev/null || true)
    backend_notify "$session" "agent-kit crew update" "crew $slug: $message"
    wake_rc=0
    if [ "${AK_NO_WAKE:-0}" != 1 ] && [ "${inject:-1}" = 1 ] && [ -n "$target" ]; then
        if backend_wake "$session" "$target" "crew $slug: $message"; then
            :
        else
            wake_rc=$?
            mark_wake_undelivered "$root" "$slug"
            printf 'error: report for crew %s was written but the primary wake was NOT delivered (exit %s); see above\n' "$slug" "$wake_rc" >&2
        fi
    fi
    printf 'crew reported: %s\n' "$slug"
    printf 'report: %s\n' "$report"
    [ "$wake_rc" = 0 ] || exit "$wake_rc"
}

cmd=${1:-}
case "$cmd" in
doctor)
    shift
    doctor "$@"
    ;;
init)
    shift
    init_dirs "$@"
    ;;
plan)
    shift
    new_plan "$@"
    ;;
lavish)
    shift
    open_lavish "$@"
    ;;
herdr-tab)
    shift
    herdr_tab "$@"
    ;;
role)
    shift
    ak_role "$@"
    ;;
whoami)
    shift
    ak_whoami "$@"
    ;;
phase)
    shift
    ak_phase "$@"
    ;;
reply)
    shift
    ak_reply "$@"
    ;;
done)
    shift
    ak_done "$@"
    ;;
chat)
    shift
    ak_chat "$@"
    ;;
primary-set)
    shift
    primary_set "$@"
    ;;
primary-show)
    shift
    primary_show "$@"
    ;;
crew-spawn)
    shift
    crew_spawn "$@"
    ;;
crew-status)
    shift
    crew_status "$@"
    ;;
crew-audit)
    shift
    crew_audit "$@"
    ;;
crew-report)
    shift
    crew_report "$@"
    ;;
crew-resume)
    shift
    crew_resume "$@"
    ;;
crew-cost)
    shift
    crew_cost "$@"
    ;;
crew-checkpoint)
    shift
    crew_checkpoint "$@"
    ;;
crew-cost-summary)
    shift
    crew_cost_summary "$@"
    ;;
crew-cost-prompt)
    shift
    crew_cost_prompt "$@"
    ;;
crew-peek)
    shift
    crew_peek "$@"
    ;;
crew-send)
    shift
    crew_send "$@"
    ;;
crew-finish)
    shift
    crew_finish "$@"
    ;;
docs)
    shift
    ak_docs "$@"
    ;;
-h | --help | help | '') usage ;;
*)
    printf 'unknown command: %s\n\n' "$cmd" >&2
    usage >&2
    exit 2
    ;;
esac
